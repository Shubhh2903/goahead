{
  "expo": {
    "name": "GoAhead",
    "slug": "goahead",
    "platforms": ["ios", "android"],
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icons/app-icon.png",
    "scheme": "goahead",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.multicodegenius.goahead.mobile",
      "appleTeamId": "S29HD2MDR4",
      "associatedDomains": ["applinks:goahead.multicodegenius.com"],
      "infoPlist": {
        "CFBundleDisplayName": "GoAhead",
        "NSLocalNetworkUsageDescription": "Allow GoAhead to connect to your desktop during local development.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/icons/app-icon.icon"
    },
    "android": {
      "package": "com.multicodegenius.goahead.mobile",
      "icon": "./assets/icons/app-icon.png",
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "./plugins/with-rocketsim",
      ["./plugins/with-android-display-name", { "displayName": "GoAhead" }],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E6C5FA",
          "image": "./assets/icons/app-icon.png",
          "imageWidth": 112,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#181818"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GoAhead to use your camera to scan QR codes.",
          "microphonePermission": "Allow GoAhead to use the microphone to dictate messages.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GoAhead to access the photos you choose to share.",
          "cameraPermission": "Allow GoAhead to use your camera to add photos.",
          "microphonePermission": "Allow GoAhead to use the microphone to dictate messages."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow GoAhead to access the photos you choose to share.",
          "savePhotosPermission": "Allow GoAhead to save images you download from a chat to your photo library.",
          "granularPermissions": ["photo"]
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-sharing",
      "expo-font",
      "expo-image",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow GoAhead to use the microphone to dictate messages.",
          "speechRecognitionPermission": "Allow GoAhead to turn your speech into message text."
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.multicodegenius.goahead.mobile.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.multicodegenius.goahead.mobile",
          "enablePushNotifications": true,
          "frequentUpdates": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
